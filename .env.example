# Optional local AWS profile and the region selected for the project.
AWS_PROFILE=
AWS_REGION=
BEDROCK_MODEL_ID=us.amazon.nova-pro-v1:0

# Set values only after the Box developer account and app are confirmed.
# Keep real secrets in .env; never commit them.
BOX_CLIENT_ID=
BOX_CLIENT_SECRET=
BOX_ENTERPRISE_ID=
# Optional managed user ID: makes demo inputs and outputs appear in that user's
# Box web account. Requires the app's existing user-token/enterprise authorization.
# Blank uses the separate application service account.
BOX_USER_ID=
# Optional short-lived alternative for an initial read-only check.
BOX_ACCESS_TOKEN=
# Hosted demos additionally require an exact HTTPS origin, explicit hosts,
# a shared demo login and a separate CloudFront origin token. Keep values private.
ARSIA_DEMO_USERNAME=
ARSIA_DEMO_PASSWORD=
ARSIA_ALLOWED_HOSTS=localhost,127.0.0.1
ARSIA_PUBLIC_ORIGIN=
ARSIA_ORIGIN_TOKEN=
