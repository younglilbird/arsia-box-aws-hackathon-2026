# Only application source, locked build inputs and frontend assets enter the build.
**
!Dockerfile
!.dockerignore
!requirements.txt
!requirements-local.txt
!constraints.txt
!app/
!app/**
!frontend/
!frontend/**

.git/
**/.git/
.env
.env.*
**/.env
**/.env.*
.local/
**/.local/
.aws/
**/.aws/
.venv/
**/.venv/
node_modules/
**/node_modules/
frontend/dist/
frontend/.test-build/
**/__pycache__/
**/*.py[cod]
**/*.tsbuildinfo
work/
outputs/
private-data/
secrets/
credentials/
*.pem
*.key
